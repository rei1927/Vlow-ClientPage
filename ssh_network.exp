#!/usr/bin/expect -f
set timeout 60
spawn ssh -o StrictHostKeyChecking=no root@pve.dayamedialangit.co.id
expect "*?assword:*"
send "Alamatgue123\r"
expect "# "
send "pct exec 100 -- bash -c 'docker network ls'\r"
expect "# "
send "pct exec 100 -- bash -c 'docker inspect waha-plus | grep NetworkMode'\r"
expect "# "
send "exit\r"
