      "id": "605ffdd2-ab17-4947-9e0f-b5b3d2d05f52",
      "name": "Is Production?"
    },
    {
      "parameters": {
        "jsCode": "const originalData = $('Merge Inputs').item.json;\nconst data = items[0].json;\nlet finalPrompt = \"\";\nlet finalKnowledge = \"\";\nlet finalFollowup = null;\n\nif (originalData.mode === 'production') {\n    finalPrompt = data.system_prompt || \"\";\n    finalKnowledge = data.knowledge || \"\";\n    finalFollowup = data.followup_config || null;\n    \n    // Tambahkan instruksi GAMBAR otomatis jika knowledge mengandung 'Attached File'\n    if (finalKnowledge.includes('Attached File')) {\n        finalPrompt += \"\\n\\nATURAN GAMBAR/FILE:\\n\";\n        finalPrompt += \"Jika CONTEXT mengandung 'Attached File (nama): URL', dan user MEMINTA atau MEMBUTUHKAN gambar/file tersebut, SERTAKAN URL file di response-mu dalam format markdown: [nama_file](URL).\\n\";\n        finalPrompt += \"Sistem akan OTOMATIS mengirim file tersebut sebagai attachment terpisah dan menghapus URL dari pesan teks.\\n\";\n        finalPrompt += \"Jika user TIDAK meminta gambar/file, cukup jawab dengan teks saja tanpa menyertakan URL.\\n\";\n        finalPrompt += \"JANGAN escalate jika informasi (termasuk gambar) sudah tersedia di CONTEXT.\";\n    }\n    \n    // Parse handover_config (might be string from Postgres)\n    let hc = data.handover_config;\n    if (typeof hc === 'string') {\n        try { hc = JSON.parse(hc); } catch(e) { hc = null; }\n    }\n    \n    if (hc && hc.enabled) {\n        const rules = [];\n        rules.push(\"\\nPENTING - ATURAN ESCALATION:\");\n        rules.push('Kamu WAJIB menyertakan JSON {\"escalate\": true, \"reason\": \"<alasan>\"} di BARIS TERAKHIR response-mu jika salah satu kondisi berikut terpenuhi:');\n\n        if (hc.escalationPrompt && hc.escalationPrompt.trim()) {\n            rules.push(\"\");\n            rules.push(\"KONDISI ESCALATION:\");\n            hc.escalationPrompt.trim().split('\\n').forEach(line => {\n                if (line.trim()) rules.push(\"• \" + line.trim());\n            });\n        }\n        \n        rules.push(\"\");\n        rules.push(\"PENTING: JANGAN escalate jika pertanyaan user BISA dijawab dari CONTEXT yang tersedia (termasuk gambar/file yang terlampir).\");\n        rules.push(\"\");\n        rules.push(\"FORMAT OUTPUT SAAT ESCALATION:\");\n        rules.push('Balas user dengan sopan, lalu DI BARIS TERAKHIR tulis: {\"escalate\": true, \"reason\": \"<alasan singkat>\"}');\n        rules.push(\"\");\n        rules.push(\"CONTOH OUTPUT ESCALATION:\");\n        rules.push('Mohon maaf, saya belum memiliki informasi mengenai hal tersebut. Saya akan menghubungkan Anda dengan tim kami.');\n        rules.push('{\"escalate\": true, \"reason\": \"Pertanyaan di luar knowledge base\"}');\n        rules.push(\"\");\n        rules.push(\"Jika TIDAK perlu escalation, JANGAN sertakan JSON escalate di response.\");\n        \n        finalPrompt += \"\\n\\n\" + rules.join(\"\\n\");\n    }\n} else {\n    finalPrompt = data.agentConfig?.systemInstruction || \"\";\n    finalKnowledge = data.agentConfig?.knowledgeBase || \"\";\n    finalFollowup = data.agentConfig?.followupConfig || null;\n    \n    // Add file instruction for simulator mode (mirrors production path)\n    if (finalKnowledge.includes('Attached File')) {\n        finalPrompt += \"\\n\\nATURAN GAMBAR/FILE:\\n\";\n        finalPrompt += \"Jika CONTEXT mengandung 'Attached File (nama): URL', dan user MEMINTA atau MEMBUTUHKAN gambar/file tersebut, SERTAKAN URL file di response-mu dalam format markdown: [nama_file](URL).\\n\";\n        finalPrompt += \"Sistem akan OTOMATIS mengirim file tersebut sebagai attachment terpisah dan menghapus URL dari pesan teks.\\n\";\n        finalPrompt += \"Jika user TIDAK meminta gambar/file, cukup jawab dengan teks saja tanpa menyertakan URL.\";\n    }\n}\n\n// Tambahan AI CRM Extraction\nfinalPrompt += \"\\n\\nATURAN EKSTRAKSI CRM (WAJIB):\\n\";\nfinalPrompt += \"Setiap kali user menyebutkan NAMA-nya (misal: 'saya Budi', 'nama saya Rina', 'ini Andi') atau KEBUTUHAN-nya (misal: 'butuh chatbot', 'mau buat website', 'cari jasa AI'), kamu WAJIB menambahkan blok JSON berikut di BARIS PALING AKHIR response-mu:\\n\";\nfinalPrompt += '{\"extracted_name\": \"<nama user>\", \"extracted_requirement\": \"<inti kebutuhan>\"}\\n';\nfinalPrompt += \"Jika hanya nama yang terdeteksi, isi extracted_requirement dengan null. Jika hanya kebutuhan, isi extracted_name dengan null.\\n\";\nfinalPrompt += \"Jika TIDAK ada nama atau kebutuhan terdeteksi, JANGAN sertakan JSON ini.\\n\";\nfinalPrompt += \"PENTING: Jika ada perintah escalate DAN ekstraksi CRM, GABUNGKAN semuanya ke dalam SATU blok objek JSON di akhir pesan. JANGAN membuat dua blok JSON.\";\n\nreturn { json: { ...originalData, ...data, finalSystemPrompt: finalPrompt, finalKnowledge: finalKnowledge, followupConfig: finalFollowup } };"
      },
