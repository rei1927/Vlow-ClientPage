    {
      "parameters": {
        "jsCode": "\nconst aiOutput = items[0].json.output;\nconst agentData = $('AI Agent2').item.json;\nlet finalMessageForUser = aiOutput;\nlet welcomeImageUrl = null;\nlet bookingData = { booking: false, escalate: false, extracted_name: null, extracted_requirement: null };\nlet promptTokens = agentData?.response_metadata?.tokenUsage?.promptTokens || agentData?.usage_metadata?.prompt_token_count || 0;\nlet completionTokens = agentData?.response_metadata?.tokenUsage?.completionTokens || agentData?.usage_metadata?.candidates_token_count || 0;\n\nif (promptTokens === 0 || completionTokens === 0) {\n    const ctx = $('Finalize Context').first().json;\n    const userMessage = ($('Set Prod Mode').isExecuted ? $('Set Prod Mode').first().json.message : ($('Meta Set Prod Mode').isExecuted ? $('Meta Set Prod Mode').first().json.message : \"\"));\n    const fullInputText = (ctx.finalSystemPrompt || \"\") + (ctx.finalKnowledge || \"\") + userMessage;\n    promptTokens = Math.ceil(fullInputText.length / 4);\n    completionTokens = Math.ceil((aiOutput || \"\").length / 4);\n}\nlet totalTokens = promptTokens + completionTokens;\n\ntry {\n    if (!aiOutput) throw new Error(\"Output kosong\");\n\n    // 1. Tangkap output JSON Booking/Escalate/CRM jika ada\n    let jsonString = null;\n    const mdMatch = aiOutput.match(/```(?:json)?\\s*(\\{[\\s\\S]*?\\})\\s*```/i);\n    if (mdMatch) {\n        jsonString = mdMatch[1];\n    } else {\n        const lastBrace = aiOutput.lastIndexOf('}');\n        const firstBrace = aiOutput.lastIndexOf('{', lastBrace);\n        if (firstBrace !== -1 && lastBrace !== -1 && (aiOutput.substring(firstBrace, lastBrace + 1).includes('\"extracted_name\"') || aiOutput.substring(firstBrace, lastBrace + 1).includes('\"escalate\"'))) {\n            jsonString = aiOutput.substring(firstBrace, lastBrace + 1);\n        } else {\n            const match = aiOutput.match(/\\{[\\s\\S]*\\}/);\n            if (match) jsonString = match[0];\n        }\n    }\n\n    if (jsonString) {\n        jsonString = jsonString.replace(/^json\\s*/i, \"\").replace(/$/i, \"\");\n        jsonString = jsonString.replace(/\\\\(?![\"\\\\/bfnrtu])/g, \"\\\\\\\\\");\n        try {\n            const parsed = JSON.parse(jsonString);\n            if (parsed.booking && String(parsed.booking).toLowerCase() === 'true') {\n                bookingData.booking = true;\n                bookingData.topic = parsed.topic;\n                bookingData.clientEmail = parsed.clientEmail;\n                let time = parsed.startTime ? parsed.startTime.replace(' ', 'T') : '';\n                if (time && time.split(':').length === 2) { time = time.includes('+') ? time.split('+')[0] + ':00+' + time.split('+')[1] : time + ':00'; }\n                if (time && !time.includes('+') && !time.endsWith('Z')) time += '+07:00';\n                bookingData.startTime = time;\n            }\n            if (parsed.escalate && String(parsed.escalate).toLowerCase() === 'true') { bookingData.escalate = true; }\n            if (parsed.extracted_name) { bookingData.extracted_name = parsed.extracted_name; }\n            if (parsed.extracted_requirement) { bookingData.extracted_requirement = parsed.extracted_requirement; }\n        } catch(e) { /* JSON parse failed, continue */ }\n        \n        finalMessageForUser = aiOutput.replace(/json[\\s\\S]*/g, \"\").trim();\n        finalMessageForUser = finalMessageForUser.replace(/\\{[\\s\\S]*\\}/g, \"\").trim();\n        finalMessageForUser = finalMessageForUser.replace(/\\x60/g, \"\").trim();\n    }\n\n    // 2. FALLBACK: Parse user's original message for CRM data\n    if (!bookingData.extracted_name || !bookingData.extracted_requirement) {\n        const userMsg = ($('Set Prod Mode').isExecuted ? $('Set Prod Mode').first().json.message : ($('Meta Set Prod Mode').isExecuted ? $('Meta Set Prod Mode').first().json.message : \"\")) || \"\";\n\n        // Detect name\n        if (!bookingData.extracted_name) {\n            const namePatterns = [\n                /(?:nama\\s+saya|saya|aku|ini|perkenalkan|gue|gw|gua)\\s+([A-Za-z][A-Za-z\\s]{1,30}?)(?:[,\\.!?]|\\s+(?:butuh|mau|ingin|perlu|cari|dari|dan|yang|lagi|pengen|minta))/i,\n                /(?:nama\\s+saya|saya|aku|ini|perkenalkan|gue|gw|gua)\\s+([A-Za-z][A-Za-z\\s]{1,30})$/i,\n            ];\n            for (const pattern of namePatterns) {\n                const match = userMsg.match(pattern);\n                if (match && match[1]) {\n                    const name = match[1].trim();\n                    if (name.length >= 2 && name.length <= 30) {\n                        bookingData.extracted_name = name.charAt(0).toUpperCase() + name.slice(1);\n                        break;\n                    }\n                }\n            }\n        }\n\n        // Detect requirement\n        if (!bookingData.extracted_requirement) {\n            const reqPatterns = [\n                /(?:butuh|mau|ingin|perlu|cari|pengen|minta|tertarik)\\s+(.{5,100}?)(?:\\.|\\n|$)/i,\n                /(?:untuk|buat)\\s+(.{5,100}?)(?:\\.|\\n|$)/i,\n            ];\n            for (const pattern of reqPatterns) {\n                const match = userMsg.match(pattern);\n                if (match && match[1]) {\n                    bookingData.extracted_requirement = match[1].trim();\n                    break;\n                }\n            }\n        }\n\n        // FALLBACK 3: Ekstrak nama dari sapaan AI sendiri (misal \"Halo Jul!\", \"Hai Budi 👋\")\n        if (!bookingData.extracted_name && finalMessageForUser) {\n            const aiGreetPatterns = [\n                /(?:halo|hai|hi|hey|hello|hallo)(?:\\s+(?:juga|lagi))?[,!]?\\s+([A-Za-z][A-Za-z]{1,20})(?:\\s*[!👋🙌✋.,]|\\s+(?:Ada|Apa|Senang|Makasih|Terima|Selamat|Dengan|Gimana))/i,\n                /(?:halo|hai|hi|hey|hello|hallo)(?:\\s+(?:juga|lagi))?[,!]?\\s+(?:Kak|Mas|Mba|Mbak|Bang|Pak|Bu)?\\s*([A-Za-z][A-Za-z]{1,20})(?:\\s*[!👋🙌✋.,])/i,\n            ];\n            for (const pattern of aiGreetPatterns) {\n                const match = finalMessageForUser.match(pattern);\n                if (match && match[1]) {\n                    const name = match[1].trim();\n                    const excludeWords = ['ada', 'apa', 'yang', 'bisa', 'ini', 'itu', 'saya', 'kami', 'kamu', 'dengan', 'lagi', 'juga', 'vlow', 'agent'];\n                    if (name.length >= 2 && name.length <= 20 && !excludeWords.includes(name.toLowerCase())) {\n                        bookingData.extracted_name = name.charAt(0).toUpperCase() + name.slice(1).toLowerCase();\n                        break;\n                    }\n                }\n            }\n        }\n    }\n\n    // 3. INLINE CRM UPDATE - Use n8n helper!\n    if (bookingData.extracted_name || bookingData.extracted_requirement) {\n        try {\n            const sqlData = $('Execute a SQL query').first().json;\n            const platformId = sqlData.platform_id || '';\n            const chatId = $('Set Prod Mode').isExecuted \n                ? $('Set Prod Mode').first().json.chatId \n                : ($('Meta Set Prod Mode').isExecuted ? $('Meta Set Prod Mode').first().json.chatId : '');\n            \n            if (platformId && chatId) {\n                const crmPayload = {\n                    platformId: platformId,\n                    chatId: chatId,\n                    customName: bookingData.extracted_name || '',\n                    requirements: bookingData.extracted_requirement || ''\n                };\n                \n                if (this.helpers && this.helpers.httpRequest) {\n                    await this.helpers.httpRequest({\n                        method: 'POST',\n                        url: 'https://api.vlow-ai.com/api/crm/profile',\n                        body: crmPayload,\n                        json: true\n                    });\n                    bookingData.crm_updated = true;\n                } else if (this.helpers && this.helpers.request) {\n                    await this.helpers.request({\n                        method: 'POST',\n                        uri: 'https://api.vlow-ai.com/api/crm/profile',\n                        body: crmPayload,\n                        json: true\n                    });\n                    bookingData.crm_updated = true;\n                } else {\n                    bookingData.crm_error = \"No HTTP helper found in n8n context\";\n                }\n            }\n        } catch (crmErr) {\n            bookingData.crm_error = crmErr.message;\n        }\n    }\n\n    // 4. TANGKAP SEMUA LINK GAMBAR/FILE\n    const mdRegex = /\\[([^]]*)\\]\\((https?:\\/\\/[^\\s)]+\\.(?:png|jpg|jpeg|gif|webp|pdf)(?:\\?[^\\s)]*)?)\\)/gi;\n    const rawRegex = /(https?:\\/\\/[^\\s]+\\.(?:png|jpg|jpeg|gif|webp|pdf)(?:\\?[^\\s]*)?)/gi;\n    const minioRegex = /https?:\\/\\/minio[^\\s]*/gi;\n\n    const firstMd = finalMessageForUser.match(/\\[([^]]*)\\]\\((https?:\\/\\/[^\\s)]+\\.(?:png|jpg|jpeg|gif|webp|pdf)(?:\\?[^\\s)]*)?)\\)/i);\n    const firstRaw = finalMessageForUser.match(/(https?:\\/\\/[^\\s]+\\.(?:png|jpg|jpeg|gif|webp|pdf)(?:\\?[^\\s]*)?)/i);\n    \n    if (firstMd) { welcomeImageUrl = firstMd[2]; }\n    else if (firstRaw) { welcomeImageUrl = firstRaw[1]; }\n    \n    finalMessageForUser = finalMessageForUser.replace(mdRegex, \"\");\n    finalMessageForUser = finalMessageForUser.replace(rawRegex, \"\");\n    finalMessageForUser = finalMessageForUser.replace(minioRegex, \"\");\n    finalMessageForUser = finalMessageForUser.replace(/\\n{3,}/g, \"\\n\\n\").trim();\n\n    // 5. Fallback WELCOME_IMAGE_URL\n    const imgMatch = finalMessageForUser.match(/WELCOME_IMAGE_URL:\\s*(\\S+)/i);\n    if (imgMatch && imgMatch[1]) {\n        welcomeImageUrl = imgMatch[1].trim();\n        finalMessageForUser = finalMessageForUser.replace(/WELCOME_IMAGE_URL:\\s*\\S+/i, \"\").trim();\n    }\n\n} catch (error) { \n    bookingData.error = error.message; \n}\n\nreturn [{ \n    json: { \n        ...bookingData, \n        welcome_image_url: welcomeImageUrl, waha_image_url: welcomeImageUrl,\n        text_for_wa: finalMessageForUser, \n        output: finalMessageForUser, \n        tokens: { prompt: promptTokens, completion: completionTokens, total: totalTokens } \n    } \n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        23968,
        3920
      ],
