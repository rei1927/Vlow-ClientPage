    },
    {
      "parameters": {
        "jsCode": "const trigger = $('WAHA Trigger').item.json;\nconst payload = trigger.payload || {};\nlet senderId = payload.from || \"\";\nif (payload.author) { senderId = payload.author; }\nconst message = payload.body || \"\";\nif (!senderId) { throw new Error('Sender ID tidak ditemukan dari WAHA Trigger'); }\nreturn { json: { mode: 'production', message: message, sessionId: senderId, chatId: senderId, platform: 'waha', wahaSession: trigger.session, agentConfig: null } };"
      },
