      "name": "Fetch Label Config",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const contactData = $('Get contact basic info').item.json;\nconst configData = items[0].json;\nconst chatLabels = contactData.labels || [];\n\n// Parse handoverConfig\nlet hc = configData.handoverConfig;\nif (typeof hc === 'string') { try { hc = JSON.parse(hc); } catch(e) { hc = {}; } }\nhc = hc || {};\n\nconst humanLabelId = String(hc.handoverLabelId || '1');\n\n// Check if any of the chat's labels match the human label ID\nconst hasHumanLabel = chatLabels.some(l => {\n  const labelId = typeof l === 'object' ? String(l.id) : String(l);\n  return labelId === humanLabelId;\n});\n\nreturn [{ json: { ...contactData, hasHumanLabel, humanLabelId, chatLabels } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20256,
        3760
      ],
      "id": "f6ac6127-d0b1-40f5-8a54-4478e1448116",
      "name": "CEK LABEL Logic"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cek-label-human-cond",
              "leftValue": "={{ $json.hasHumanLabel }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        20480,
        3760
      ],
      "id": "81ccd5fa-ebdf-49c9-8c7a-461541635961",
      "name": "CEK LABEL"
    },
    {
      "parameters": {
        "jsCode": "const aiOutput = items[0].json.output || \"\";\nlet text = aiOutput;\nlet imageUrl = null;\n\nconst mdRegex = /\\[([^\\]]*)\\]\\((https?:\\/\\/[^\\s)]+\\.(?:png|jpg|jpeg|gif|webp|pdf)(?:\\?[^\\s)]*)?)\\)/i;\nconst rawRegex = /(https?:\\/\\/[^\\s]+\\.(?:png|jpg|jpeg|gif|webp|pdf)(?:\\?[^\\s]*)?)/i;\n\nconst mdMatch = text.match(mdRegex);\nif (mdMatch) {\n    imageUrl = mdMatch[2];\n    text = text.replace(mdMatch[0], \"\").trim();\n} else {\n    const rawMatch = text.match(rawRegex);\n    if (rawMatch) {\n        imageUrl = rawMatch[1];\n        text = text.replace(rawMatch[0], \"\").trim();\n    }\n}\n\nreturn [{ json: { output: text, welcome_image_url: imageUrl } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        23968,
        4112
