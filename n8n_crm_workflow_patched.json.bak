    {
      "parameters": {
        "httpMethod": "POST",
        "path": "/meta-cloud-webhook",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        20480,
        4208
      ],
      "id": "ab11f7b8-ed4b-4d37-b530-24c7b89f5b64",
      "name": "Meta Cloud Webhook",
      "webhookId": "meta-cloud-combined-001"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse Meta Cloud API webhook payload\nconst body = $json.body || $json;\nconst entry = body.entry || [];\n\nif (!entry.length) return { json: { skip: true } };\n\nconst changes = entry[0]?.changes || [];\nif (!changes.length) return { json: { skip: true } };\n\nconst value = changes[0]?.value;\nif (!value || !value.messages || !value.messages.length) {\n  return { json: { skip: true } };\n}\n\nconst msg = value.messages[0];\nconst contacts = value.contacts || [];\nconst contact = contacts.find(c => c.wa_id === msg.from) || {};\nconst metadata = value.metadata || {};\n\nlet messageBody = '';\nswitch (msg.type) {\n  case 'text': messageBody = msg.text?.body || ''; break;\n  case 'image': messageBody = msg.image?.caption || ''; break;\n  case 'video': messageBody = msg.video?.caption || ''; break;\n  case 'audio': messageBody = ''; break;\n  case 'location': messageBody = '📍 Lokasi: ' + (msg.location?.latitude || '') + ', ' + (msg.location?.longitude || ''); break;\n  case 'document': messageBody = msg.document?.caption || msg.document?.filename || ''; break;\n  default: messageBody = '(' + msg.type + ')';\n}\n\nreturn {\n  json: {\n    skip: false,\n    phoneNumberId: metadata.phone_number_id,\n    from: msg.from,\n    messageId: msg.id,\n    timestamp: msg.timestamp,\n    type: msg.type,\n    body: messageBody,\n    contactName: contact.profile?.name || msg.from,\n    sessionId: 'meta_' + metadata.phone_number_id\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20704,
        4208
      ],
      "id": "1fb49e53-de24-43dc-9d17-a3e0bff00a29",
      "name": "Parse Meta Payload"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "meta-skip-check",
              "leftValue": "={{ $json.skip }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        20928,
        4208
      ],
      "id": "426dc14b-6d4b-44c8-b699-590a9f54595e",
      "name": "Has Message?"
    },
    {
      "parameters": {
        "jsCode": "const trigger = $('Parse Meta Payload').item.json;\nconst senderId = trigger.from || '';\nconst message = trigger.body || '';\n\nif (!senderId) { throw new Error('Sender ID tidak ditemukan dari Meta webhook'); }\n\nreturn {\n  json: {\n    mode: 'production',\n    message: message,\n    sessionId: senderId,\n    chatId: senderId,\n    platform: 'meta_cloud',\n    phoneNumberId: trigger.phoneNumberId,\n    metaSessionId: trigger.sessionId,\n    contactName: trigger.contactName,\n    agentConfig: null\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        21152,
        4208
      ],
