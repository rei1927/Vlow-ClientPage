        "url": "={{ (() => { const imgUrl = $('Code in JavaScript').item.json.waha_image_url || ''; if (!imgUrl || !imgUrl.includes('minio.dayamedialangit.co.id')) return imgUrl; const parts = imgUrl.replace('https://minio.dayamedialangit.co.id/', '').split('/'); const bucket = parts.shift(); const object = parts.join('/'); return 'https://api.vlow-ai.com/api/agents/knowledge/proxy-image?bucket=' + encodeURIComponent(bucket) + '&object=' + encodeURIComponent(object); })() }}",
