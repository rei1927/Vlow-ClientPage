    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  a.\"id\" AS agent_id,\n  cp.\"id\" AS platform_id,\n  cp.\"phoneNumberId\" AS \"phoneNumberId\",\n  cp.\"systemUserAccessToken\" AS \"systemUserAccessToken\",\n  a.\"name\" AS agent_name,\n  a.\"systemInstruction\" AS system_prompt,\n  a.\"welcomeMessage\" AS greeting,\n  a.\"welcomeImageUrl\" AS welcome_image,\n  a.\"followupConfig\" AS followup_config,\n  a.\"handoverConfig\" AS handover_config,\n  COALESCE(a.\"knowledgeBase\", '') || E'\\n\\n' || \n  COALESCE(\n    (\n      SELECT string_agg(\n        '=== ' || ks.title || ' ===' || E'\\n' || ks.description || \n        CASE WHEN ks.\"fileUrl\" IS NOT NULL \n          THEN E'\\nAttached File (' || COALESCE(ks.\"fileName\", 'file') || '): ' || ks.\"fileUrl\"\n          ELSE '' \n        END,\n        E'\\n\\n'\n      )\n      FROM \"KnowledgeSources\" ks\n      WHERE ks.\"agentId\" = a.id\n    ),\n    ''\n  ) AS knowledge\nFROM \"ConnectedPlatforms\" cp\nJOIN \"Agents\" a ON cp.\"agentId\" = a.id\nWHERE cp.\"sessionId\" = '{{ $('WAHA Trigger').isExecuted ? $('WAHA Trigger').item.json.session : ($('Meta Set Prod Mode').isExecuted ? $('Meta Set Prod Mode').item.json.metaSessionId : '') }}';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        21824,
        4016
      ],
      "id": "36edf615-3376-40b5-b4d9-8c22dac045aa",
      "name": "Execute a SQL query",
      "credentials": {
