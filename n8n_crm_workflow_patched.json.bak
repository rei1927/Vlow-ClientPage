    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $('Finalize Context').item.json;\nconst followup = ctx.followupConfig || {};\nconst delay = Number(followup.delay) || 15;\nconst unit = followup.unit === 'hours' ? 'hours' : 'minutes';\nlet text = followup.prompt || \"\";\ntext = text.replace(/<[^>]*>/g, \"\").replace(/&nbsp;/g, \" \").trim();\nreturn { json: { ...$json, followup_delay_amount: delay, followup_delay_unit: unit, followup_text: text } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
